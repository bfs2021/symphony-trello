#!/bin/bash

set -euo pipefail

mapfile -t shell_scripts < <(git grep -IlE '^#!(/bin/bash|/usr/bin/env bash)$')
if ((${#shell_scripts[@]} == 0)); then
  echo "No tracked Bash scripts found." >&2
  exit 1
fi

case "${1:-}" in
syntax)
  # bash -n parses only its first path and passes the rest as arguments, so check each file and
  # keep going after a failure to report every broken script in one run.
  status=0
  for script in "${shell_scripts[@]}"; do
    bash -n -- "$script" || status=$?
  done
  exit "$status"
  ;;
shellcheck)
  shellcheck -- "${shell_scripts[@]}"
  ;;
shfmt)
  shfmt -d -- "${shell_scripts[@]}"
  ;;
*)
  echo "Usage: scripts/check-shell-scripts <syntax|shellcheck|shfmt>" >&2
  exit 2
  ;;
esac
